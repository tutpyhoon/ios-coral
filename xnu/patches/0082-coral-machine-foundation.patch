diff --git a/pexpert/pexpert/arm64/CORAL.h b/pexpert/pexpert/arm64/CORAL.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/CORAL.h
@@ -0,0 +1,77 @@
+/*
+ * Board config for the Google Pixel 4 XL ("coral", Qualcomm SM8150 / Snapdragon 855).
+ * Kryo 485: 4 efficiency + 3 performance + 1 prime cores; ARMv8.2, no PAC.
+ *
+ * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's
+ * implementation-defined system registers exist), 16K pages and GICv3 like
+ * VMAPPLE. Unlike VMAPPLE the GIC has two security states (GICD_TYPER
+ * SecurityExtn=1): Group 0 belongs to TrustZone, so every interrupt,
+ * including the timer, is a Group 1 IRQ taken through sleh_irq().
+ */
+
+#ifndef _PEXPERT_ARM64_CORAL_H
+#define _PEXPERT_ARM64_CORAL_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define CORAL                     1
+
+/* CPU0 only until SM8150 PSCI and per-cluster GICR bring-up are validated. */
+#define CORAL_BOOT_CPU_LIMIT      1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * The live Coral FDT specifies virtual timer PPI 3: INTID 16 + 3 = 19.
+ * Bootloader interrupt routing remains unverified.
+ */
+#define CORAL_VTIMER_INTID        19
+#define CORAL_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_CORAL_H */
diff --git a/iokit/Kernel/arm/CoralPlatformExpert.cpp b/iokit/Kernel/arm/CoralPlatformExpert.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/CoralPlatformExpert.cpp
@@ -0,0 +1,86 @@
+/*
+ * Initial device-tree platform expert for Google Pixel 4 XL (coral).
+ * Uses XNU's normal platform, power-domain and nub initialization. Hardware
+ * interrupt and power-management services are supplied by separate drivers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(CORAL)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class CoralPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(CoralPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	bool getTargetName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+	bool getProductName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(CoralPlatformExpert, IODTPlatformExpert);
+
+bool
+CoralPlatformExpert::start(IOService *provider)
+{
+	IOLog("CORAL: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("CORAL: platform expert registered\n");
+	return true;
+}
+
+const char *
+CoralPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+CoralPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+CoralPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node.
+	 * CORAL has no NVRAM controller; publish real CPU/device nodes without
+	 * inventing one. createNubs adds the topology's logical CPU/cluster IDs.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+}
+
+bool
+CoralPlatformExpert::getTargetName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "coral", (size_t)maxLength);
+	return true;
+}
+
+bool
+CoralPlatformExpert::getProductName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "Pixel 4 XL", (size_t)maxLength);
+	return true;
+}
+#endif /* CORAL */
diff --git a/iokit/Kernel/arm/CoralCPU.cpp b/iokit/Kernel/arm/CoralCPU.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/CoralCPU.cpp
@@ -0,0 +1,171 @@
+/*
+ * Unvalidated CPU0-only prototype for Coral / SM8150 using IOCPU.
+ * Virtual timer / SGI interrupt routing on CORAL is not implemented yet.
+ * Secondary CPU startup and system suspend require separate platform work.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(CORAL)
+#include <IOKit/IOCPU.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <arm64/proc_reg.h>
+#include <machine/atomic.h>
+#include <kern/clock.h>
+#include <kern/processor.h>
+#include <mach/mach_time.h>
+
+class CoralCPU : public IOCPU {
+	OSDeclareDefaultStructors(CoralCPU);
+	const OSSymbol *cpuName = NULL;
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	void signalCPU(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	const OSSymbol *getCPUName(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(CoralCPU, IOCPU);
+
+bool
+CoralCPU::start(IOService *provider)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	const ml_topology_cpu_t *cpu = topology->boot_cpu;
+	OSNumber *logical = OSDynamicCast(OSNumber, provider->getProperty("logical-cpu-id"));
+	OSData *reg = OSDynamicCast(OSData, provider->getProperty("reg"));
+
+	if (logical == NULL || reg == NULL || reg->getLength() != sizeof(uint32_t) ||
+	    logical->unsigned32BitValue() != cpu->cpu_id ||
+	    *(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
+		return false;
+	}
+	if (topology->num_cpus != CORAL_BOOT_CPU_LIMIT || cpu->phys_id != 0) {
+		panic("CORAL CPU: only single-CPU bring-up is supported");
+	}
+	if (!IOCPU::start(provider)) {
+		return false;
+	}
+	cpuName = OSSymbol::withCStringNoCopy("Kryo 485");
+	if (cpuName == NULL) {
+		return false;
+	}
+	setCPUNumber(cpu->cpu_id);
+
+	ml_processor_info_t info = {};
+	info.cpu_id = reinterpret_cast<cpu_id_t>(this);
+	info.phys_id = cpu->phys_id;
+	info.log_id = cpu->cpu_id;
+	info.cluster_id = cpu->cluster_id;
+	info.cluster_type = cpu->cluster_type;
+	info.l2_cache_id = cpu->l2_cache_id;
+	info.l2_cache_size = cpu->l2_cache_size;
+	info.l3_cache_id = cpu->l3_cache_id;
+	info.l3_cache_size = cpu->l3_cache_size;
+	perfmon_interrupt_handler_func pmi_handler = NULL;
+	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
+	if (result != KERN_SUCCESS) {
+		panic("CORAL CPU: ml_processor_register failed: %d", result);
+	}
+	if (pmi_handler != NULL) {
+		panic("CORAL CPU: PMI routing is not implemented");
+	}
+
+	/* Re-enter the boot CPU through cpu_machine_init -> PE_cpu_machine_init. */
+	result = processor_start(machProcessor);
+	if (result != KERN_SUCCESS || getCPUState() != kIOCPUStateRunning) {
+		panic("CORAL CPU: processor_start failed: %d", result);
+	}
+	ml_cpu_init_completed();
+	cpusRunning();
+	registerService();
+	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
+
+	/* Announce completion only after registration, startup and SGI validation. */
+	ml_set_max_cpus(topology->max_cpu_id + 1);
+	IOLog("CORAL CPU: boot CPU %u registered, SGI1 verified, initialization complete\n",
+	    getCPUNumber());
+	return true;
+}
+
+void
+CoralCPU::free(void)
+{
+	OSSafeReleaseNULL(cpuName);
+	IOCPU::free();
+}
+
+void
+CoralCPU::initCPU(bool boot)
+{
+	if (!boot) {
+		panic("CORAL CPU: resume is not implemented");
+	}
+	assert(cpu_number() == (int)getCPUNumber());
+	assert(ml_get_interrupts_enabled());
+	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
+
+	/* A real GIC interrupt clears SIGPdisabled in cpu_signal_handler. */
+	uint64_t deadline;
+	nanoseconds_to_deadline(NSEC_PER_SEC, &deadline);
+	signalCPU(this);
+	while (!ml_cpu_signal_is_enabled()) {
+		if (mach_absolute_time() > deadline) {
+			panic("CORAL CPU: SGI1 self-test timed out");
+		}
+		__asm__ volatile("yield");
+	}
+	setCPUState(kIOCPUStateRunning);
+}
+
+void
+CoralCPU::signalCPU(IOCPU *target)
+{
+	/* Only the boot CPU is registered by this driver. */
+	if (target != this || cpu_number() != (int)getCPUNumber()) {
+		panic("CORAL CPU: secondary CPU signalling is not implemented");
+	}
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	unsigned int aff0 = mpidr & 0xff;
+	if (aff0 >= 16) {
+		panic("CORAL CPU: SGI target requires unsupported range selector");
+	}
+	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+	    (((mpidr >> 16) & 0xff) << 32) |
+	    (((mpidr >> 8) & 0xff) << 16) |
+	    ((uint64_t)CORAL_IPI_SGI << 24) | (1ULL << aff0);
+	__builtin_arm_dsb(DSB_ISHST);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	__builtin_arm_isb(ISB_SY);
+}
+
+kern_return_t
+CoralCPU::startCPU(vm_offset_t start_paddr __unused, vm_offset_t arg_paddr __unused)
+{
+	return KERN_NOT_SUPPORTED;
+}
+
+void
+CoralCPU::quiesceCPU(void)
+{
+	panic("CORAL CPU: CPU quiesce is not implemented");
+}
+
+void
+CoralCPU::haltCPU(void)
+{
+	panic("CORAL CPU: CPU halt/suspend is not implemented");
+}
+
+const OSSymbol *
+CoralCPU::getCPUName(void)
+{
+	return cpuName;
+}
+#endif /* CORAL */
